<% layout('/layouts/boilerplate') %>

<section class="home d-flex align-items-center justify-content-center">
  <div class="container text-center">
    <div class="home-content">
      <h1 class="display-4">Welcome to <span class="fw-bold">TripNest</span></h1>
      <i class="fas fa-hotel fa-3x mb-3"></i>
      <p class="lead">Find and book your next adventure with comfort and ease.</p>

      <% if (!currUser) { %>
        <a href="/signup" class="btn btn-primary mt-3">Sign Up Now</a>
        <p class="mt-2">Already a member? <a href="/login" class="text-white text-decoration-underline">Login</a></p>
      <% } else { %>
        <a href="/listings" class="btn btn-success mt-3">Explore Listings</a>
      <% } %>
    </div>
    <hr class="my-4">

<div class="ai-suggestion text-light">
  <h2>Need Help Planning a Trip?</h2>
  <form id="suggestForm" class="mt-3 d-flex flex-column align-items-center">
    <input
      type="text"
      name="query"
      class="form-control w-75 mb-2"
      placeholder="E.g., A quiet 3-day hill station near Bangalore"
      required
    />
    <button type="submit" class="btn btn-warning">Get AI Suggestion</button>
  </form>

  <div id="result" class="mt-3 bg-dark p-3 rounded w-75 mx-auto text-start" style="white-space: pre-wrap;"></div>
</div>
  </div>
</section>

